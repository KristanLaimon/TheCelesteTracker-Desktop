---
import { Image } from "astro:assets";
import Layout from "../../Layout.astro";
import VanillaChapters from "@components/vanilla/VanillaChapters.svelte";
import farewellBanner from "@assets/bg_horizontal_farewell_banner.jpg";
import madelineArtwork from "@assets/madeline_artwork_pendingcredits.png";
---

<Layout
  title="Vanilla Chapters"
  bodyClassNames="antialiased selection:bg-primary selection:text-white bg-bg-base text-zinc-100 font-body"
>
  <main class="min-h-screen pb-20">
    <section class="relative isolate min-h-[360px] overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <Image src={farewellBanner} alt="" class="h-full w-full object-cover opacity-35" />
        <div class="absolute inset-0 bg-linear-to-b from-bg-base/25 via-bg-base/65 to-bg-base"></div>
      </div>

      <div class="mx-auto flex max-w-7xl flex-col items-center px-6 py-12 text-center md:px-12 md:py-16">
        <div class="relative">
          <div class="absolute inset-6 rounded-full bg-primary/25 blur-3xl"></div>
          <img
            src={madelineArtwork.src}
            alt="Madeline Artwork"
            class="relative mx-auto w-36 drop-shadow-[0_0_30px_rgba(255,120,140,0.32)] sm:w-44 md:w-52"
          />
        </div>

        <div class="mt-6 max-w-3xl">
          <p class="text-[11px] font-bold uppercase tracking-[0.32em] text-secondary">Celeste campaign only</p>
          <h1 class="mt-3 text-4xl font-headline font-black tracking-tight text-white sm:text-5xl md:text-6xl">
            Vanilla <span class="text-secondary">Chapters</span>
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-base font-medium leading-7 text-zinc-400 md:text-lg">
            A fixed collection for the original Celeste climb, separated from modded campaigns.
          </p>
        </div>
      </div>
    </section>

    <section class="relative z-10 -mt-8 px-6 md:px-12">
      <div class="mx-auto max-w-[1600px]">
        <VanillaChapters client:load />
      </div>
    </section>
  </main>
</Layout>

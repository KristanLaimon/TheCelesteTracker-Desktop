{
	"$schema": "neutralino.config.schema.json",
	"applicationId": "js.neutralino.zero",
	"version": "1.0.0",
	"defaultMode": "window",
	"documentRoot": "/resources",
	"url": "/",
	"enableServer": true,
	"enableExtensions": true,
	"enableNativeAPI": true,
	"tokenSecurity": "none",
	"port": 6767,
	"logging": {
		"enabled": true,
		"writeToLogFile": true
	},
	"nativeAllowList": [
		"filesystem.readDirectory",
		"filesystem.getStats",
		"filesystem.readFile",
    "filesystem.getAbsolutePath",
		"window.show",
		"os.setTray",
		"os.open",
		"os.showNotification",
		"os.showMessageBox",
		"os.getPath",
    "extensions.getStats"
	],
	"modes": {
		"window": {
			"title": "myapp",
			"width": 800,
			"height": 500,
			"minWidth": 400,
			"minHeight": 200,
			"hidden": true,
			"icon": "src/assets/straw_berry_icon.png"
		}
	},
	"extensions": [
		{
			"id": "utilities",
			"commandLinux": "${NL_PATH}/extensions/utilities/utilities-linux_x64",
			"commandDarwin": "${NL_PATH}/extensions/utilities/utilities-mac_x64",
			"commandWindows": "\"${NL_PATH}/extensions/utilities/utilities-win_x64.exe\""
		}
	],
	"cli": {
		"binaryName": "myapp",
		"resourcesPath": "/resources",
		"extensionsPath": "/extensions/",
		"binaryVersion": "6.8.0",
		"clientVersion": "6.8.0",
		"frontendLibrary": {
			"patchFile": "/index.html",
			"devUrl": "http://localhost:5173",
			"projectPath": ".",
			"initCommand": "bun install",
			"devCommand": "bun run vite",
			"buildCommand": "bun run build:frontend"
		}
	}
}

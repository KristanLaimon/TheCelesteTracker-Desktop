{
	"$schema": "neutralino.config.schema.json",
	"applicationId": "js.neutralino.zero",
	"version": "1.0.0",
	"defaultMode": "window",
	"documentRoot": "/dist/vite-temp-build",
	"url": "/",
	"enableServer": true,
	"enableExtensions": false,
	"enableNativeAPI": true,
	"tokenSecurity": "none",
	"port": 6767,
	"logging": {
		"enabled": true,
		"writeToLogFile": true
	},
	"nativeAllowList": [
		"filesystem.readDirectory",
		"filesystem.getStats",
		"filesystem.readFile",
		"filesystem.getAbsolutePath",
		"filesystem.createDirectory",
    "filesystem.writeFile",
		"window.show",
		"os.setTray",
		"os.open",
		"os.showNotification",
		"os.showMessageBox",
		"os.getPath",
		"os.execCommand",
		"server.mount",
		"server.getMounts"
	],
	"modes": {
		"window": {
			"title": "myapp",
			"width": 800,
			"height": 500,
			"minWidth": 400,
			"minHeight": 200,
			"hidden": true,
			"icon": "src/assets/straw_berry_icon.png"
		}
	},
	"cli": {
		"binaryName": "myapp",
		"resourcesPath": "/dist/vite-temp-build",
		"extensionsPath": "/extensions/",
		"binaryVersion": "6.8.0",
		"clientVersion": "6.8.0",
		"autoReloadExclude": "(\\.git|node_modules|\\.tmp|dist|.*\\.log)",
		"frontendLibrary": {
			"patchFile": "/index.html",
			"devUrl": "http://localhost:5173",
			"projectPath": ".",
			"initCommand": "bun install",
			"devCommand": "bun run vite",
			"buildCommand": "bun run build:frontend"
		}
	}
}

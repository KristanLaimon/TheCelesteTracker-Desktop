{
	"name": "neutralinojs-svelte-template",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"start": "neu run -- --window-enable-inspector",
		"build:frontend": "vite build",
		"build:windows": "bun run build --skip-linux",
		"build:noextensions": "neu build --embed-resources",
		"build": "bun build.js",
		"check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.vite.json",
		"test": "bun test",
		"lint": "biome check . --write --unsafe"
	},
	"dependencies": {
		"@neutralinojs/lib": "6.8.0",
		"@panzoom/panzoom": "^4.6.2",
		"@tailwindcss/vite": "4.3.2",
		"dompurify": "^3.4.12",
		"dotenv": "^17.4.2",
		"golden-layout": "2.6.0",
		"hotkeys-js": "^4.0.4",
		"interactjs": "1.10.27",
		"js-yaml": "^5.2.1",
		"marked": "^18.0.6",
		"reflect-metadata": "^0.2.2",
		"serialize-error": "^13.0.1",
		"tailwindcss": "4.3.2",
		"tsyringe": "4.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tsconfig/svelte": "5.0.8",
		"@types/bun": "1.3.14",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "26.1.1",
		"cross-env": "10.1.0",
		"flowbite-svelte-icons": "^3.1.0",
		"svelte": "5.56.4",
		"svelte-check": "4.7.1",
		"typescript": "6.0.2",
		"vite": "8.1.1"
	}
}
